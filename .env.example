# ---- LLM: Google Gemini, free tier (key from aistudio.google.com) ----
OPENAI_API_KEY=<your AI Studio key>
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=1.0          # Google advises against <1.0 for Gemini 3+
LLM_MAX_TOKENS=4096          # covers thinking + answer
LLM_MAX_RETRIES=6            # 429 back-off: 4, 8, 16, 32, 60, 60 s; per-day limits fail fast
# LLM_REASONING_EFFORT=low   # optional, sent only when set

# ---- ...or OpenAI: remove OPENAI_BASE_URL and use e.g. ----
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=800
# EVAL_JUDGE_MODEL=gpt-4o-mini
# EVAL_JUDGE_TEMPERATURE=
# EVAL_EMBEDDING_MODEL=text-embedding-3-small
# (an empty value such as `EVAL_JUDGE_TEMPERATURE=` means "use the default")


# ---- Retrieval models (sentence-transformers) ----
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
RERANKER_MODEL=BAAI/bge-reranker-base
# DEVICE=cuda

# ---- Retrieval knobs ----
BM25_TOP_K=50
DENSE_TOP_K=50
RRF_K=60
RERANK_CANDIDATES=40
FINAL_TOP_K=5
# Below this cross-encoder score (0-1) a passage is not treated as evidence.
REFUSAL_SCORE_THRESHOLD=0.20

# ---- Postgres ----
# Admin URL: used by `clinrag db init/load` (write access).
DATABASE_ADMIN_URL=postgresql+psycopg://clinrag:clinrag@localhost:5432/clinical
# Read-only URL: used by the text-to-SQL tool at query time.
DATABASE_URL=postgresql+psycopg://clinrag_readonly:readonly@localhost:5432/clinical

# ---- Prompt ----
PROMPT_VERSION=v4

# ---- Evaluation ----
# A different model from LLM_MODEL, so the judge never grades its own answers.
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
EVAL_JUDGE_TEMPERATURE=1.0
EVAL_JUDGE_MAX_TOKENS=4096
EVAL_EMBEDDING_MODEL=gemini-embedding-001
EVAL_CONCURRENCY=1
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- LangSmith tracing ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=clinical-guideline-rag
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
